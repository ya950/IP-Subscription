<div id="remark-help-modal" class="modal">
    <div class="modal-content" style="max-width: 600px;">
        <div class="modal-header">
            <h3 class="modal-title">💡 备注处理功能说明</h3>
            <span class="close" onclick="document.getElementById('remark-help-modal').style.display='none'">&times;</span>
        </div>
        <div class="modal-body" style="font-size: 0.95rem; line-height: 1.6;">
            <p style="margin-bottom: 1rem;">在文本框中，<b>每行填写一条规则</b>，系统会自动按顺序处理节点备注。</p>
            
            <h4 style="color: var(--primary); margin-top: 1rem;">1. 筛选保留 (白名单)</h4>
            <div style="background: #f8fafc; padding: 0.75rem; border-radius: 0.5rem; border-left: 3px solid var(--primary); margin-bottom: 1rem;">
                <b>语法：</b> <code>+关键词</code><br>
                <b>示例：</b> <code>+香港</code> （系统将<b>仅保留</b>备注中含有"香港"的节点）
            </div>

            <h4 style="color: var(--danger); margin-top: 1rem;">2. 排除剔除 (黑名单)</h4>
            <div style="background: #f8fafc; padding: 0.75rem; border-radius: 0.5rem; border-left: 3px solid var(--danger); margin-bottom: 1rem;">
                <b>语法：</b> <code>-关键词</code><br>
                <b>示例：</b> <code>-测速</code> （系统将<b>直接删除</b>所有备注中含有"测速"的节点）
            </div>

            <h4 style="color: var(--warning); margin-top: 1rem;">3. 统一重命名</h4>
            <div style="background: #f8fafc; padding: 0.75rem; border-radius: 0.5rem; border-left: 3px solid var(--warning); margin-bottom: 1rem;">
                <b>语法：</b> <code>ALL=新名字</code><br>
                <b>示例：</b> <code>ALL=我的专属节点</code> （将所有剩下的节点统一改成此名字）
            </div>

            <h4 style="color: var(--success); margin-top: 1rem;">4. 替换与删除文字 (旧版功能)</h4>
            <div style="background: #f8fafc; padding: 0.75rem; border-radius: 0.5rem; border-left: 3px solid var(--success); margin-bottom: 1rem;">
                <b>替换：</b> <code>旧文字->新文字</code> （例：<code>US->美国</code>）<br>
                <b>删除：</b> <code>直接输入要删除的字</code> （例：输入 <code>官网</code>，则"官网"字样会被抹除）
            </div>

            <p style="font-size: 0.85rem; color: var(--text-sub); margin-top: 1rem;">
                * 💡 小技巧：多行规则可以混合使用！系统会<b>先执行过滤</b>(+和-)，然后再执行<b>重命名或替换</b>。
            </p>
        </div>
        <div class="modal-footer" style="padding-top: 1rem;">
            <button class="btn-primary" onclick="document.getElementById('remark-help-modal').style.display='none'">我知道了</button>
        </div>
    </div>
</div>

 <script>
 (function(){
 let appData = {};
 const currentOrigin = '${originVar}';
 const base64Var = '${base64Var}';
 let lastExtractResult = []; 
 let currentEditingFile = null;
 let currentEditingIPs = [];
 let currentSubFile = null; 
  
 try { 
     const raw = atob(base64Var);
     appData = JSON.parse(decodeURIComponent(escape(raw))); 
     appData.urls = (appData.urls || []).map(u => typeof u === 'string' ? {name:'', url:u} : u);
     appData.apis = (appData.apis || []).map(u => typeof u === 'string' ? {name:'', url:u} : u);
     appData.templatesList = appData.templatesList || [];
     
     if (appData.ipFiles) {
         appData.ipFiles.forEach(f => f._collapsed = true);
     }
 } catch(e) { console.error('Init Error', e); }
  
 function formatBeijingTime(isoString) {
     if (!isoString) return '--';
     const date = new Date(isoString);
     return date.toLocaleString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false, timeZone: 'Asia/Shanghai' });
 }

 window.toggleCard = function(name) {
      const file = appData.ipFiles.find(f => f.name === name);
      if (file) {
          file._collapsed = !file._collapsed;
          render(); 
      }
  };

 window.copyText = function(id) {
    const text = document.getElementById(id).innerText;
    navigator.clipboard.writeText(text);
    showMsg('已复制到剪贴板');
 };
  
 function escapeHtml(s) { 
    if(!s) return '';
    return s.toString()
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;"); 
 }

 function render() {
     const renderSourceList = (id, list, type) => {
         document.getElementById(id).innerHTML = list.map((item, i) => {
             // [新增] 只有 API 且开启了缓存，才显示个小标签
             const cacheBadge = (type === 'apis' && item.useCache) ? '<span class="badge auto" style="margin-left:0.5rem; background:var(--warning-light); color:var(--warning);">📦 防断缓存</span>' : '';
             return '<div class="item"><div class="item-content"><div style="font-weight:700;color:var(--text-main); font-size: 1rem;">' + (item.name ? escapeHtml(item.name) : '<span style="color:#94a3b8;font-style:italic">未命名</span>') + cacheBadge + '</div><div style="font-size:0.875rem;color:var(--text-sub);margin-top:0.25rem;word-break:break-all">' + escapeHtml(item.url || item.value) + '</div></div><button class="btn-danger" data-action="delete" data-type="' + type + '" data-val="' + i + '" style="padding:0.5rem 1rem;font-size:0.875rem;">🗑️ 删除</button></div>';
         }).join('');
     };
     renderSourceList('url-list', appData.urls, 'urls');
     renderSourceList('api-list', appData.apis, 'apis');
     
     document.getElementById('tpl-list').innerHTML = (appData.templatesList || []).map((item, i) => 
         '<div class="item"><div class="item-content"><div style="font-weight:700;color:var(--text-main); font-size: 1rem;">📋 ' + escapeHtml(item.name) + '</div><div style="font-size:0.875rem;color:var(--text-sub);margin-top:0.25rem;word-break:break-all">' + escapeHtml(item.value) + '</div></div><div style="display:flex;gap:0.5rem"><button class="btn-warning" data-action="edit-tpl" data-val="' + i + '" style="padding:0.5rem 1rem;font-size:0.875rem;">✏️ 编辑</button><button class="btn-danger" data-action="delete" data-type="templates" data-val="' + i + '" style="padding:0.5rem 1rem;font-size:0.875rem;">🗑️ 删除</button></div></div>'
     ).join('');

     const tplSelect = document.getElementById('tpl-select');
     if(tplSelect) {
         const options = (appData.templatesList || []).map(function(t) {
             return '<option value="' + escapeHtml(t.value) + '">' + escapeHtml(t.name) + '</option>';
         }).join('');
         tplSelect.innerHTML = '<option value="">-- 请选择模板 --</option>' + options;
     }
     
     document.getElementById('uploaded-list').innerHTML = appData.uploadedFiles.map(t => 
         '<div class="item"><div class="item-content">📄 <strong style="font-size: 1rem;">' + escapeHtml(t) + '</strong></div><div style="display:flex; gap:0.75rem;"><button class="btn-secondary preview-btn" data-filename="' + escapeHtml(t) + '" style="padding:0.5rem 1rem;font-size:0.875rem;">👁️ 预览</button><button class="btn-danger" data-action="delete-file" data-val="' + escapeHtml(t) + '" style="padding:0.5rem 1rem;font-size:0.875rem;">🗑️ 删除</button></div></div>'
     ).join('');
  
     const ipSitesHtml = [];
     const friendSitesHtml = [];
     (appData.sitesList || []).forEach((s, realIdx) => {
         if(s.type === 'ip') {
            ipSitesHtml.push('<div class="item"><div class="item-content"><a href="' + escapeHtml(s.url) + '" target="_blank" style="font-weight:700;color:var(--primary);text-decoration:none;font-size: 1rem;">🔗 ' + escapeHtml(s.name) + '</a><div style="color:var(--text-sub);font-size:0.875rem;margin-top:0.25rem">' + escapeHtml(s.url) + '</div></div><button class="btn-danger" data-action="del-site" data-val="' + realIdx + '" style="padding:0.5rem 1rem;font-size:0.875rem;">🗑️ 删除</button></div>');
         } else if(s.type === 'friend') {
            friendSitesHtml.push('<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;"><a href="' + escapeHtml(s.url) + '" target="_blank" class="link-card" style="flex:1;margin-bottom:0">👉 ' + escapeHtml(s.name) + '</a><span data-action="del-site" data-val="' + realIdx + '" style="cursor:pointer;color:var(--text-sub);font-size:0.875rem;padding:0.25rem 0.5rem; border-radius: 0.25rem; transition: all 0.2s;">✕</span></div>');
         }
     });
     document.getElementById('site-list-ip').innerHTML = ipSitesHtml.join('');
     document.getElementById('friend-links-list').innerHTML = friendSitesHtml.join('');
  
     const renderChecks = (prefix) => {
         let html = '';
         if(appData.uploadedFiles.length) {
             html += '<div style="grid-column:1/-1;font-weight:700;color:var(--primary);margin-top:0.5rem;margin-bottom:0.75rem;padding-bottom:0.5rem;border-bottom:1px solid var(--border); display: flex; align-items: center; gap: 0.5rem;">📂 上传的文件</div>';
             appData.uploadedFiles.forEach(f => { html += '<label><input type="checkbox" value="' + escapeHtml(f) + '" class="' + prefix + '-file-cb"> ' + escapeHtml(f) + '</label>'; });
         }
         if(appData.editableFiles.length) {
             html += '<div style="grid-column:1/-1;font-weight:700;color:#7c3aed;margin-top:0.5rem;margin-bottom:0.75rem;padding-bottom:0.5rem;border-bottom:1px solid var(--border); display: flex; align-items: center; gap: 0.5rem;">✏️ 可编辑文件</div>';
             appData.editableFiles.forEach(f => { html += '<label><input type="checkbox" value="' + escapeHtml(f.name) + '" class="' + prefix + '-file-cb"> ' + escapeHtml(f.name) + '</label>'; });
         }
         if(appData.urls.length) {
