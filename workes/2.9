// 【新增】全局内存缓存：如果在同一批次内多次请求同一个源，直接复用结果，防拉黑且提速百倍
const globalMemCache = new Map();

async function performExtraction(env, sources, forceRefresh = false, remarkOps = null) {
  let nodeMap = new Map();
  const [urls, apis, uploadedFiles] = await Promise.all([
      DataAccessLayer.readConfig(env, 'urls', [], forceRefresh),
      DataAccessLayer.readConfig(env, 'apis', [], forceRefresh),
      DataAccessLayer.readConfig(env, 'uploaded_files', [], forceRefresh)
  ]);
  let allCandidates = [];
  
  if (sources.files && Array.isArray(sources.files)) {
      const filePromises = sources.files.map(async (fileName) => {
          if (uploadedFiles.includes(fileName)) {
              const content = await DataAccessLayer.readFile(env, 'upload', fileName);
              if (content) return IPExtractor.processBatch(content).map(r => ({...r, source: 'file'}));
          } 
          else {
              try {
                  const editableData = await DataAccessLayer.getEditableFile(env, fileName);
                  if (editableData && editableData.ips && Array.isArray(editableData.ips)) {
                      return editableData.ips.map(r => ({...r, source: 'editable'}));
                  }
              } catch(e) {}
          }
          return [];
      });
      (await Promise.all(filePromises)).forEach(r => allCandidates.push(...r));
  }
  
  const BROWSER_UA = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36';
  
  // 1. 处理 API 源 (加入内存复用)
  for (const i of (sources.apis || [])) {
      const item = apis[i];
      if (item && item.url) {
          // [新增] 判断当前这个 API 是否开启了缓存功能
          const enableBackup = item.useCache === true;

          const tryFetchApi = async (targetUrl, proxyLevel = 0) => {
              const cacheKey = `api_${targetUrl}_${proxyLevel}`;
              const cached = globalMemCache.get(cacheKey);
              if (cached && (Date.now() - cached.time < 120000)) return cached.data;

              const backupName = `backup/api_${btoa(encodeURIComponent(item.url)).replace(/[^a-zA-Z0-9]/g, '').substring(0, 50)}.json`;

              try {
                  const c = new AbortController(); const id = setTimeout(() => c.abort(), 25000); 
                  const res = await fetch(targetUrl, { signal: c.signal, headers: { 'Cache-Control': 'no-store', 'User-Agent': BROWSER_UA } }); 
                  const txt = await res.text(); clearTimeout(id);
                  const nodes = IPExtractor.processBatch(txt);
                  
                  if (nodes.length > 0) {
                      const resData = nodes.map(r => ({...r, source: 'api'}));
                      globalMemCache.set(cacheKey, { time: Date.now(), data: resData });
                      
                      // [核心修改] 只有勾选了“开启缓存”，才往 R2 里面写入数据
                      if (enableBackup && (proxyLevel === 0 || proxyLevel === 1)) {
                          await env[R2_BUCKET_NAME].put(backupName, JSON.stringify(resData)).catch(()=>{});
                      }
                      return resData;
                  }
                  if (proxyLevel === 0 && txt.toLowerCase().includes('<html')) throw new Error('API WAF Blocked');
                  throw new Error('未抓取到有效节点');
              } catch(e) {
                  let retryRes = [];
                  if (proxyLevel === 0) retryRes = await tryFetchApi(`https://api.allorigins.win/raw?url=${encodeURIComponent(item.url)}`, 1);
                  if (retryRes && retryRes.length > 0) return retryRes;
                  
                  // [核心修改] 只有勾选了“开启缓存”，失败时才去 R2 找兜底数据
                  if (enableBackup && proxyLevel === 0) {
                      try {
                          console.log(`[按需容灾生效] API ${item.url} 抓取失败，读取历史备份...`);
                          const backupObj = await env[R2_BUCKET_NAME].get(backupName);
                          if (backupObj) {
                              const backupData = await backupObj.json();
                              if (backupData && backupData.length > 0) return backupData;
                          }
                      } catch(err) {}
                  }
                  return [];
              }
          };
          const r = await tryFetchApi(item.url);
          r.forEach(x => allCandidates.push(x));
      }
  }

  // 2. 处理 订阅源 URL (加入内存复用)
  for (const i of (sources.urls || [])) {
      const item = urls[i];
      if (item && item.url) {
          const tryFetchUrl = async (targetUrl, proxyLevel = 0) => {
              const cacheKey = `url_${targetUrl}_${proxyLevel}`;
              const cached = globalMemCache.get(cacheKey);
              if (cached && (Date.now() - cached.time < 120000)) return cached.data;

              // [新增] 生成 R2 备份文件名
              const backupName = `backup/url_${btoa(encodeURIComponent(targetUrl)).replace(/[^a-zA-Z0-9]/g, '').substring(0, 50)}.json`;

              try {
                  const c = new AbortController(); const id = setTimeout(() => c.abort(), 15000); 
                  const fetchHeaders = {
                      'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36',
                      'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8',
                      'Accept-Language': 'zh-CN,zh;q=0.9,en;q=0.8',
                      'Cache-Control': 'no-cache',
                      'Pragma': 'no-cache',
                      'Sec-Fetch-Dest': 'document',
                      'Sec-Fetch-Mode': 'navigate',
                      'Sec-Fetch-Site': 'none',
                      'Upgrade-Insecure-Requests': '1'
                  };
                  const res = await fetch(targetUrl, { headers: fetchHeaders, signal: c.signal }); 
                  const txt = await res.text(); clearTimeout(id);
                  const nodes = parseSubscription(txt);
                  
                  if (nodes.length > 0) {
                      const resData = nodes.map(r => ({...r, source: 'sub'}));
                      globalMemCache.set(cacheKey, { time: Date.now(), data: resData });
                      
                      // [新增] 抓取成功时，写入 R2 备份
                      if (proxyLevel === 0 || proxyLevel === 1) {
                          await env[R2_BUCKET_NAME].put(backupName, JSON.stringify(resData)).catch(()=>{});
                      }
                      return resData;
                  }
                  
                  if (txt.toLowerCase().includes('<html') && proxyLevel < 3) throw new Error('WAF Blocked or No IPs parsed');
                  return [];
              } catch(e) {
                  let retryRes = [];
                  // 代理重试轮询
                  if (proxyLevel === 0) retryRes = await tryFetchUrl(`https://api.allorigins.win/raw?url=${encodeURIComponent(targetUrl)}`, 1);
                  else if (proxyLevel === 1) retryRes = await tryFetchUrl(`https://api.codetabs.com/v1/proxy?quest=${encodeURIComponent(targetUrl)}`, 2);
                  else if (proxyLevel === 2) retryRes = await tryFetchUrl(`https://corsproxy.io/?${encodeURIComponent(targetUrl)}`, 3);
                  
                  if (retryRes && retryRes.length > 0) return retryRes;

                  // [新增] 如果所有代理节点都失效了，读取 R2 备份兜底
                  if (proxyLevel === 0) {
                      try {
                          const backupObj = await env[R2_BUCKET_NAME].get(backupName);
                          if (backupObj) {
                              const backupData = await backupObj.json();
                              if (backupData && backupData.length > 0) return backupData;
                          }
                      } catch(err) {}
                  }
                  return [];
              }
          };
          const r = await tryFetchUrl(item.url);
          r.forEach(x => allCandidates.push(x));
      }
  }


  // --- 增强版备注与筛选逻辑 (筛选 + 统一命名) ---
 if (remarkOps && typeof remarkOps === 'string' && remarkOps.trim() !== '') {
 // [修复] 自动将中文全角的 ＋ 和 － 替换为英文符号，防止输入法坑人
 const rules = remarkOps.split('\n')
          .map(r => r.trim().replace(/^＋/, '+').replace(/^－/, '-'))
          .filter(r => r);

 // [修复] 提取关键词时，统一转成小写，并且去掉前后多余空格
 const includes = rules.filter(r => r.startsWith('+')).map(r => r.slice(1).trim().toLowerCase());
 const excludes = rules.filter(r => r.startsWith('-')).map(r => r.slice(1).trim().toLowerCase());
 const setAllRule = rules.find(r => r.startsWith('ALL=') || r.startsWith('all='));
 const replaceRules = rules.filter(r => !r.startsWith('+') && !r.startsWith('-') && !r.startsWith('ALL=') && !r.startsWith('all='));

 if (includes.length > 0 || excludes.length > 0) {
 allCandidates = allCandidates.filter(node => {
 // [修复] 将 IP 和备注拼在一起，全部强制转成小写，实现无死角匹配
 const targetText = `${node.ip || ''} ${node.remark || ''}`.toLowerCase();
 let keep = true;
 
 if (includes.length > 0) keep = includes.some(inc => targetText.includes(inc));
 if (keep && excludes.length > 0) {
 if (excludes.some(exc => targetText.includes(exc))) keep = false;
 }
 return keep;
});
 }

 allCandidates = allCandidates.map(node => {
 let newRemark = node.remark || '';
 if (setAllRule) {
 newRemark = setAllRule.substring(4).trim();
 } else {
 replaceRules.forEach(rule => {
 if (rule.includes('->')) {
 const [target, replacement] = rule.split('->');
 if (target) {
 const escapedTarget = target.trim().replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                          // [修复] 替换时也忽略大小写 (gi)
 newRemark = newRemark.replace(new RegExp(escapedTarget, 'gi'), replacement.trim() || '');
 }
 } else {
 const escapedTarget = rule.trim().replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
 newRemark = newRemark.replace(new RegExp(escapedTarget, 'gi'), '');
 }
 });
 }
 return { ...node, remark: newRemark };
 });
 }

  // -------------------------

  for (const node of allCandidates) {
      let cleanIp = node.ip.endsWith('.') ? node.ip.slice(0, -1) : node.ip;
      cleanIp = cleanIp.toLowerCase();
      const key = `${cleanIp}:${node.port || 443}`;
      if (!nodeMap.has(key)) nodeMap.set(key, node.remark || ''); 
      else { const old = nodeMap.get(key); if (old === 'ERR' || old === 'UN' || old === 'TIMEOUT' || (!old && node.remark)) nodeMap.set(key, node.remark || ''); }
  }

  const tasks = [];
  for (let [key, remark] of nodeMap) { if (!remark) { const [ip, port] = key.split(':'); tasks.push({ key, ip, port }); } }

  const MAX_QUERY = 200; 
  const BATCH_SIZE = 15; 
  if (tasks.length > 0) {
      const processTasks = tasks.slice(0, MAX_QUERY); 
      for (let i = 0; i < processTasks.length; i += BATCH_SIZE) {
          const batch = processTasks.slice(i, i + BATCH_SIZE);
          await Promise.all(batch.map(async (task) => {
              const code = await queryExternalAPI(task.ip, task.port);
              if (code && code !== 'ERR' && code !== 'TIMEOUT') nodeMap.set(task.key, code);
          }));
      }
  }
  const result = [];
  for (let [key, remark] of nodeMap) result.push(remark ? `${key}#${remark}` : key);
  return result;
}

function parseSubscription(c) {
  const n = []; let d = c;
  try {
      let cleanStr = c.replace(/\s/g, '');
      if (cleanStr.length > 20 && !cleanStr.includes('://')) {
          cleanStr = cleanStr.replace(/-/g, '+').replace(/_/g, '/');
          while (cleanStr.length % 4) { cleanStr += '='; }
          d = decodeURIComponent(escape(atob(cleanStr)));
      }
  } catch (e) { d = c; }

  d.split(/[\r\n]+/).forEach(l => {
    const t = l.trim(); if (!t) return;
    
    // Vmess
    if (t.startsWith('vmess://')) { 
        try { 
            let base64 = t.substring(8); 
            base64 = base64.replace(/\s/g, '').replace(/-/g, '+').replace(/_/g, '/');
            const jsonStr = decodeURIComponent(escape(atob(base64))); 
            const j = JSON.parse(jsonStr); 
            if (IPExtractor.isValidAddress(j.add)) n.push({ ip: j.add, port: j.port, remark: j.ps }); 
            return; 
        } catch (e) {} 
    }
    
    // Vless / Trojan / SS
    if (t.match(/^(vless|trojan|ss):\/\//)) { 
        try { 
            const u = new URL(t); 
            if (IPExtractor.isValidAddress(u.hostname)) n.push({ ip: u.hostname, port: u.port, remark: u.hash ? decodeURIComponent(u.hash.substring(1)) : '' }); 
            return; 
        } catch(e) {} 
    }
    
    const processed = IPExtractor.processBatch([t]);
    if (processed.length > 0) n.push(processed[0]);
  });
  return n;
}

async function queryExternalAPI(ip, port, retry = 0) {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 3000);
    try {
        const apiUrl = retry > 0 ? `http://ip-api.com/json/${ip}?fields=countryCode` : `https://ipinfo.io/${ip}/json`;
        const res = await fetch(apiUrl, { headers: { 'User-Agent': 'Mozilla/5.0 (compatible; Node-IP-Checker/1.0)' }, cf: { cacheTtl: 3600, cacheEverything: true }, signal: controller.signal });
        clearTimeout(timeoutId);
        const data = await res.json();
        let code = 'UN';
        if (data.country) code = data.country; else if (data.countryCode) code = data.countryCode; 
        return code;
    } catch (e) { clearTimeout(timeoutId); if (e.name === 'AbortError') return 'TIMEOUT'; if (retry < 1) return await queryExternalAPI(ip, port, retry + 1); return 'ERR'; }
}

async function extractIPs(req, env) { const b = await req.json(); const r = await performExtraction(env, b.sources, false, b.remarkOps); return new Response(JSON.stringify({ ips: r, count: r.length })); }

async function handleToolQuery(request) {
    const { ipList, deduplicate } = await request.json();
    if (!ipList || !Array.isArray(ipList)) throw new Error('无效的IP/域名列表');
    let items = IPExtractor.processBatch(ipList);
    if (deduplicate) items = IPExtractor.deduplicateIPs(items);
    if (items.length > 200) throw new Error('一次最多查询200个');
    const processedNodes = [];
    const pendingNodes = items; 
    const BATCH_SIZE = 15;
    for (let i = 0; i < pendingNodes.length; i += BATCH_SIZE) {
        const batch = pendingNodes.slice(i, i + BATCH_SIZE);
        const results = await Promise.all(batch.map(async (item) => { const code = await queryExternalAPI(item.ip, item.port); return { ...item, remark: code }; }));
        processedNodes.push(...results);
    }
    const finalResults = processedNodes.map(item => { const fmt = item.port ? `${item.ip}:${item.port}#${item.remark}` : `${item.ip}#${item.remark}`; return { formatted: fmt, success: item.remark !== 'ERR' && item.remark !== 'TIMEOUT' }; });
    return new Response(JSON.stringify({ results: finalResults }), { headers: { 'Content-Type': 'application/json' } });
}

async function logout(req, env) { 
    const c = req.headers.get('Cookie'); 
    if(c) { 
        const id = c.split('session=')[1]?.split(';')[0]; 
        if(id) {
            try { await env[KV_BINDING_NAME].delete(`session_${id}`); } catch(e){} 
            try { await env[R2_BUCKET_NAME].delete(`sessions/${id}`); } catch(e){} // [新增] 退出时清理 R2 的 session
        }
    } 
    return new Response(null, { status: 302, headers: { 'Set-Cookie': 'session=; HttpOnly; Secure; SameSite=Strict; Path=/; Max-Age=0', 'Location': '/admin' } }); 
}

async function checkSession(req, env) { 
    const c = req.headers.get('Cookie'); if(!c) return false; 
    const id = c.match(/session=([^;]+)/)?.[1]; if(!id) return false; 
    
    // 1. 优先查 KV
    try { 
        const kvCheck = await env[KV_BINDING_NAME].get(`session_${id}`);
        if (kvCheck === 'valid') return true;
    } catch(e) {}
    
    // 2. 【R2 兜底】如果 KV 查不到或抛出配额异常，去 R2 找对应的 UUID 凭证
    try {
        const r2Check = await env[R2_BUCKET_NAME].get(`sessions/${id}`);
        if (r2Check) return true;
    } catch(e) {}
    
    return false;
}

