    .compact-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        transition: all 0.2s;
        box-shadow: var(--shadow);
        height: fit-content;
        position: relative;
        overflow: hidden;
    }
    .compact-card:hover {border-color:var(--primary);transform:translateY(-2px);box-shadow:var(--shadow-lg)}
    .card-header {
        display:flex;justify-content:space-between;align-items:flex-start;
        margin-bottom:0.75rem;border-bottom:1px solid #f1f5f9;padding-bottom:0.75rem;
        cursor: pointer;
    }
    .card-title {font-weight:700;color:var(--text-main);font-size:1rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-right:0.5rem}
    .card-body {flex:1;margin-bottom:1rem}
    .stat-row {display:flex;justify-content:space-between;font-size:0.8rem;color:var(--text-sub);margin-top:0.5rem;background:#f8fafc;padding:0.5rem;border-radius:0.375rem}
    .link-row {display:flex;gap:0.5rem;margin-top:0.5rem;font-size:0.75rem}
    .link-row a {text-decoration:none;padding:0.2rem 0.5rem;border-radius:0.25rem;background:#f1f5f9;color:var(--text-sub);transition:all .2s}
    .link-row a:hover {background:var(--primary-light);color:var(--primary)}
    .action-bar {display:flex;gap:0.5rem;padding-top:0.75rem;border-top:1px solid #f1f5f9}
    .icon-btn {flex:1;display:inline-flex;align-items:center;justify-content:center;padding:0.5rem;border:none;border-radius:0.375rem;cursor:pointer;font-size:1rem;transition:all .2s;background:#f8fafc;color:var(--text-sub)}
    .icon-btn:hover {background:#e2e8f0;color:var(--text-main)}
    .icon-btn.primary:hover {background:var(--primary);color:#fff}
    .icon-btn.warning:hover {background:var(--warning);color:#fff}
    .icon-btn.danger:hover {background:var(--danger);color:#fff}
    .icon-btn.purple:hover {background:#8b5cf6;color:#fff}

    .compact-card.collapsed .card-body,
    .compact-card.collapsed .action-bar { display: none; }
    .compact-card.collapsed .card-header { margin-bottom: 0; border-bottom: none; padding-bottom: 0; }
    .toggle-icon { transition: transform 0.3s ease; font-size: 0.8rem; color: var(--text-sub); padding: 4px; margin-left: 8px; }
    .compact-card.collapsed .toggle-icon { transform: rotate(-90deg); }

    @media (max-width:800px){.tools-layout{grid-template-columns:1fr}}@media (max-width:640px){.container{padding:0 0.5rem}.tab{padding:0.5rem 1rem;font-size:0.875rem}.tab-content{padding:1.5rem 1rem}.item{flex-direction:column;align-items:flex-start;gap:1rem}.item button{width:100%}.checkbox-group{grid-template-columns:1fr}.control-buttons{flex-direction:column;align-items:stretch}.checkbox-control{margin-left:0;margin-top:0.75rem}}
</style>
