// [New] Rename File Logic
async function renameFileAPI(req, env) {
    const { oldName, newName } = await req.json();
    if (!oldName || !newName) return new Response(JSON.stringify({ error: 'Invalid names' }), { status: 400 });
    
    const manifest = await DataAccessLayer.getManifest(env);
    if (manifest[newName]) return new Response(JSON.stringify({ error: 'Target filename already exists' }), { status: 400 });
    const meta = manifest[oldName];
    if (!meta) return new Response(JSON.stringify({ error: 'Original file not found' }), { status: 404 });

    // 1. Copy Content
    if (meta.editable) {
        const data = await DataAccessLayer.getEditableFile(env, oldName);
        if (data) await DataAccessLayer.saveEditableFile(env, newName, data);
        await DataAccessLayer.deleteEditableFile(env, oldName);
    } else {
        const content = await DataAccessLayer.readFile(env, 'generated', oldName);
        if (content) await DataAccessLayer.writeFile(env, 'generated', newName, content);
        await DataAccessLayer.deleteFile(env, 'generated', oldName);
    }

    // 2. Move Stats
    const stats = await DataAccessLayer.getStats(env, oldName);
    await DataAccessLayer.updateStats(env, newName, stats);
    await env[KV_BINDING_NAME].delete(`stats_${oldName}`);
    await R2Manager.delete(env, 'stats', `stats_${oldName}`);

    // 3. Update Manifest
    meta.name = newName;
    manifest[newName] = meta;
    delete manifest[oldName];
    await DataAccessLayer.updateManifest(env, oldName, null); // remove old
    await DataAccessLayer.updateManifest(env, newName, meta); // add new

    return new Response(JSON.stringify({ success: true, newName, meta }));
}

