        if (!tpl.startsWith('vless://') && !tpl.startsWith('trojan://') && !tpl.startsWith('ss://')) return alert('仅支持 vless, trojan 或 ss 协议');

        const base64Tpl = btoa(unescape(encodeURIComponent(tpl)));
        const finalUrl = currentOrigin + '/tpl/' + currentSubFile + '?template=' + encodeURIComponent(base64Tpl);
        
        document.getElementById('tpl-final-url').innerText = finalUrl;
        document.getElementById('tpl-result-area').style.display = 'block';
        document.getElementById('short-link-tip').style.display = 'none';
     }

     if (btn.id === 'btn-gen-short-link') {
        const tpl = document.getElementById('tpl-input').value.trim();
