// 10. 管理页面 (并行加载优化版)
// ==========================================
async function handleAdmin(req, env) {
  const url = new URL(req.url); 
  const sess = await checkSession(req, env);
  const clientIP = req.headers.get('CF-Connecting-IP') || 'unknown';
  const failKey = `login_fail_${clientIP}`;

  if (!sess && url.searchParams.get('action') !== 'login') {
      return new Response(getLoginPage(), { headers: { 'Content-Type': 'text/html; charset=utf-8' }});
  }

  if (url.searchParams.get('action') === 'login') {
    let failRecord = { count: 0, blockUntil: 0 };
    try { failRecord = await env[KV_BINDING_NAME].get(failKey, { type: 'json' }) || { count: 0, blockUntil: 0 }; } catch(e){}
    
    const now = Date.now();
    if (failRecord.blockUntil > now) {
        const waitMs = failRecord.blockUntil - now;
        const waitHours = Math.floor(waitMs / 3600000);
        const waitMins = Math.ceil((waitMs % 3600000) / 60000);
        let timeStr = waitHours > 0 ? `${waitHours} 小时 ${waitMins} 分钟` : `${waitMins} 分钟`;
        return new Response(getLoginPage(`⚠️ 登录失败次数过多，IP 已被锁定。<br>请等待 ${timeStr} 后再试。`), { headers: { 'Content-Type': 'text/html; charset=utf-8' }});
    }

    const fd = await req.formData();
    if (fd.get('password') === env.ADMIN_PASSWORD) {
      try { await env[KV_BINDING_NAME].delete(failKey); } catch(e){}
      const id = crypto.randomUUID(); 
      try {
          // 优先存入 KV
          await env[KV_BINDING_NAME].put(`session_${id}`, 'valid', { expirationTtl: 86400 });
      } catch(e) {
          // 【R2 兜底安全写入】KV 满了，则在 R2 的 sessions/ 目录下生成一个校验文件，完全没有密码泄漏风险
          await env[R2_BUCKET_NAME].put(`sessions/${id}`, 'valid').catch(()=>{});
      }
      return new Response('', { status: 302, headers: { 'Set-Cookie': `session=${id}; HttpOnly; Secure; SameSite=Strict; Path=/; Max-Age=86400`, 'Location': '/admin' } });
    } else {
      failRecord.count = (failRecord.count || 0) + 1;
      let errorMsg = `密码错误 (已尝试 ${failRecord.count} 次)`;
      if (failRecord.count >= 5) { failRecord.blockUntil = now + 86400000; errorMsg = `密码错误。失败次数过多，IP 已被锁定 24 小时。`; }
      try { await env[KV_BINDING_NAME].put(failKey, JSON.stringify(failRecord), { expirationTtl: 86460 }); } catch(e){}
      return new Response(getLoginPage(errorMsg), { headers: { 'Content-Type': 'text/html; charset=utf-8' }});
    }
  }

  // [Deleted] custom_ips from parallel load
  const [urls, apis, uploadedFiles, sitesList, templatesList, manifest] = await Promise.all([
      DataAccessLayer.readConfig(env, 'urls'),
      DataAccessLayer.readConfig(env, 'apis'),
      DataAccessLayer.readConfig(env, 'uploaded_files'),
      DataAccessLayer.readConfig(env, 'sites_list'),
      DataAccessLayer.readConfig(env, 'templates_list'),
      DataAccessLayer.getManifest(env)
  ]);

  const fileEntries = Object.entries(manifest);
  const fileResults = [];
  
  // [核心修复]：将 Promise.all 并发轰炸改为分批处理，每次处理 5 个
  const BATCH_SIZE = 5;
  for (let i = 0; i < fileEntries.length; i += BATCH_SIZE) {
      const batch = fileEntries.slice(i, i + BATCH_SIZE).map(async ([name, meta]) => {
          if (!meta) return null;
          try {
              const stats = await DataAccessLayer.getStats(env, name);
              if (meta.editable) {
                  const editableData = await DataAccessLayer.getEditableFile(env, name);
                  return { type: 'editable', data: { ...meta, stats, ips: editableData ? editableData.ips : [] } };
              } else {
                  return { type: 'generated', data: { ...meta, stats } };
              }
          } catch (e) { return null; }
      });
      const results = await Promise.all(batch);
      fileResults.push(...results);
  }
  const ipFiles = [];
  const editableFiles = [];
  
  fileResults.forEach(res => {
      if (!res) return;
      if (res.type === 'editable') editableFiles.push(res.data);
      else ipFiles.push(res.data);
  });

  const jsonStr = JSON.stringify({ urls, apis, uploadedFiles, ipFiles, editableFiles, sitesList, templatesList });
  const base64Data = btoa(unescape(encodeURIComponent(jsonStr)));
  
  return new Response(getAdminPage(base64Data, url.origin), { 
      headers: { 
          'Content-Type': 'text/html; charset=utf-8',
          'Cache-Control': 'no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0',
          'Pragma': 'no-cache',
          'Expires': '0',
          'Surrogate-Control': 'no-store',
          'Last-Modified': new Date().toUTCString()
      } 
  });
}
  
