async function exportBackup(env) {
    const [urls, apis, sites_list, templates_list, manifest] = await Promise.all([
        DataAccessLayer.readConfig(env, 'urls'),
        DataAccessLayer.readConfig(env, 'apis'),
        DataAccessLayer.readConfig(env, 'sites_list'),
        DataAccessLayer.readConfig(env, 'templates_list'),
        DataAccessLayer.getManifest(env)
    ]);

    const editableFilesData = {};
    if (manifest) {
        for (const [name, meta] of Object.entries(manifest)) {
            if (meta.editable) {
                const data = await DataAccessLayer.getEditableFile(env, name);
                if (data && data.ips) editableFilesData[name] = data.ips;
            }
        }
    }

    const backupData = {
        version: '10.19',
        timestamp: new Date().toISOString(),
        configs: { urls, apis, sites_list, templates_list, manifest },
        editableFiles: editableFilesData
    };

    const fileName = `Node_Backup_${new Date().toISOString().split('T')[0]}.json`;
    return new Response(JSON.stringify(backupData), {
        headers: {
            'Content-Type': 'application/json',
            'Content-Disposition': `attachment; filename="${fileName}"`
        }
    });
}

async function importBackup(request, env) {
    try {
        const data = await request.json();
        if (!data || !data.configs) throw new Error("无效的备份文件");

        const { configs, editableFiles } = data;
        if (configs.urls) await DataAccessLayer.writeConfig(env, 'urls', configs.urls);
        if (configs.apis) await DataAccessLayer.writeConfig(env, 'apis', configs.apis);
        if (configs.sites_list) await DataAccessLayer.writeConfig(env, 'sites_list', configs.sites_list);
        if (configs.templates_list) await DataAccessLayer.writeConfig(env, 'templates_list', configs.templates_list);
        
        if (configs.manifest) {
            await R2Manager.save(env, 'config', 'manifest', configs.manifest);
            await CacheManager.setCache(env, 'manifest', 'all', configs.manifest);
        }

        if (editableFiles) {
            for (const [name, ips] of Object.entries(editableFiles)) {
                await DataAccessLayer.saveEditableFile(env, name, { ips });
            }
        }
        
        await CacheManager.clearTypeCache(env, 'metadata');
        return new Response(JSON.stringify({success: true}));
    } catch(e) {
        return new Response(JSON.stringify({error: e.message}), {status: 400});
    }
}
